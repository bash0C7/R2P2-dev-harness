# rake fpga:check が buses.rb に与える入力。1行 "<step> <番地> <値>"
# 262 = 0x106 は外から L にするピン: GPIO 20 (A) と 21 (B) で時計回り、次に反時計回り
3000 262 1048576
5000 262 3145728
7000 262 2097152
9000 262 0
11000 262 2097152
13000 262 3145728
15000 262 1048576
17000 262 0
# 391 = 0x187 は I2C の番地 64..95 の応答 (bit 16 = 0x50)、388 = 0x184 は I2C の返事、401 = 0x191 は SPI の返事
0 391 65536
0 388 18
0 388 52
0 388 86
0 401 12
0 401 128
0 401 170
0 401 187
0 401 204
# 263 = 0x107 は外から H にするピン: HC-SR04 の echo (GPIO 0) を trig の後 1166 µs (約 20 cm) だけ H に
26600 263 1
27766 263 0
