# rake fpga:check が uart_echo.rb に与える入力。1行 "<step> <番地> <値>"。289 = 0x121 は UART の受信バイト
# (その step から読める、届いた順)、262 = 0x106 は外から L にする GPIO のピン (bit 5 = GPIO 5)
8000 289 104
8001 289 105
8002 289 10
10000 262 32
15000 262 0
20000 289 111
20500 289 107
21000 289 10
30000 289 121
30000 289 111
30000 289 10
