 {
   if (started) return 0;
 
+#ifdef PICORUBY_QEMU_EVQ_RIG
+  /* Event-path rig: no radio under QEMU. Keep the ring, the write queue
+   * and the heartbeat timer alive; the injector task stands in for the
+   * NimBLE host task. */
+  extern void rig_start(void);
+  (void)setup;
+  ensure_timers();
+#if defined(PICORB_VM_MRUBYC)
+  picoruby_nimble_attach_vm(NULL);
+#endif
