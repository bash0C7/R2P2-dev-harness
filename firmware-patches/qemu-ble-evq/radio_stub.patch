+/* rig: drive disc_dsc_cb from the injector task the way the host would, so a
+ * refused result and the completion that follows take the board's path. */
+static int disc_dsc_cb(uint16_t conn, const struct ble_gatt_error *error,
+                       uint16_t chr_val_handle, const struct ble_gatt_dsc *dsc, void *arg);
+
+void
+rig_gatt_dsc_result(uint16_t conn, uint16_t handle)
+{
+  struct ble_gatt_error ok = { .status = 0 };
+  struct ble_gatt_dsc dsc;
+  memset(&dsc, 0, sizeof(dsc));
+  dsc.handle = handle;
+  dsc.uuid.u.type = BLE_UUID_TYPE_16;
+  dsc.uuid.u16.value = 0x2902;
+  disc_dsc_cb(conn, &ok, 0, &dsc, NULL);
