diff --git a/components/picoruby-esp32/CMakeLists.txt b/components/picoruby-esp32/CMakeLists.txt
index 169620b3..ba73238b 100644
--- a/components/picoruby-esp32/CMakeLists.txt
+++ b/components/picoruby-esp32/CMakeLists.txt
@@ -66,6 +66,41 @@ if(CONFIG_BT_NIMBLE_ENABLED)
   set(MRUBY_USE_BLE 1)
 endif()

+# picoruby PR #427 event-path rig (R2P2-dev-harness overlay; never committed)
+if(DEFINED ENV{PICORUBY_QEMU_EVQ_RIG})
+  list(APPEND ADDITIONAL_DEFINITIONS -DPICORUBY_QEMU_EVQ_RIG)
+  list(APPEND BLE_SRCS ${COMPONENT_DIR}/rig_injector.c)
+  list(APPEND BLE_SRCS ${COMPONENT_DIR}/rig_nimble_stubs.c)
+  foreach(fn ble_gap_adv_stop ble_gap_adv_set_data ble_gap_adv_start ble_gap_adv_active ble_gap_terminate ble_gap_conn_active ble_gap_conn_cancel ble_gap_disc ble_gap_disc_cancel ble_gap_disc_active ble_gap_connect ble_gap_conn_find ble_hs_id_copy_addr ble_hs_util_ensure_addr ble_hs_id_infer_auto nimble_port_get_dflt_eventq)
+    list(APPEND ADDITIONAL_DEFINITIONS -D${fn}=rig_${fn})
+  endforeach()
+endif()
+
+if(DEFINED ENV{PICORUBY_QEMU_EVQ_FLOOD})
+  list(APPEND ADDITIONAL_DEFINITIONS -DPICORUBY_QEMU_EVQ_FLOOD)
+endif()
+
+if(DEFINED ENV{PICORUBY_QEMU_EVQ_FLOOD_SPACING_MS})
+  list(APPEND ADDITIONAL_DEFINITIONS -DFLOOD_SPACING_MS=$ENV{PICORUBY_QEMU_EVQ_FLOOD_SPACING_MS})
+endif()
+
+if(DEFINED ENV{PICORUBY_QEMU_EVQ_LIMITS})
+  list(APPEND ADDITIONAL_DEFINITIONS -DPICORUBY_QEMU_EVQ_LIMITS)
+  list(APPEND ADDITIONAL_DEFINITIONS -DPICORUBY_BLE_EVQ_BYTES=1024)
+endif()
+
+if(DEFINED ENV{PICORUBY_QEMU_EVQ_POWER})
+  list(APPEND ADDITIONAL_DEFINITIONS -DPICORUBY_QEMU_EVQ_POWER)
+endif()
+
+if(DEFINED ENV{PICORUBY_QEMU_EVQ_RESYNC})
+  list(APPEND ADDITIONAL_DEFINITIONS -DPICORUBY_QEMU_EVQ_RESYNC)
+endif()
+
+if(DEFINED ENV{PICORUBY_QEMU_EVQ_OLD_PORT})
+  list(APPEND ADDITIONAL_DEFINITIONS -DPICORUBY_QEMU_EVQ_OLD_PORT)
+endif()
+
 if(DEFINED ENV{HEAP_SIZE})
   list(APPEND ADDITIONAL_DEFINITIONS -DHEAP_SIZE=$ENV{HEAP_SIZE})
 endif()
diff --git a/components/picoruby-esp32/build_config/xtensa-esp-femtoruby.rb b/components/picoruby-esp32/build_config/xtensa-esp-femtoruby.rb
index dcaadc15..c29d901d 100644
--- a/components/picoruby-esp32/build_config/xtensa-esp-femtoruby.rb
+++ b/components/picoruby-esp32/build_config/xtensa-esp-femtoruby.rb
@@ -22,7 +22,8 @@ MRuby::CrossBuild.new("esp32-femtoruby") do |conf|
   conf.cc.defines << "NDEBUG"
   conf.cc.defines << "MRBC_TASK_SCHEDULER_HOOK"
   conf.cc.defines << "USE_WIFI" if ENV['USE_WIFI']
-  conf.cc.defines << "MAX_SYMBOLS_COUNT=2000" if ENV['USE_BLE']
+  conf.cc.defines << "PICORUBY_QEMU_EVQ_RIG" if ENV['PICORUBY_QEMU_EVQ_RIG']
+  conf.cc.defines << "MAX_SYMBOLS_COUNT=2000" if ENV['USE_BLE'] && !ENV['PICORUBY_QEMU_EVQ_RIG']
 
   conf.femtoruby(alloc_libc: false)
   conf.gembox 'minimum'
