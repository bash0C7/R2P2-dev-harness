# BLE fragment for the qemu-ble-evq rig: NimBLE host headers and the
# picoruby-ble port sources need CONFIG_BT_NIMBLE_ENABLED, but the rig
# never initializes the stack (radio_stub.patch), so the controller —
# whose static buffers also disturb the QEMU memory layout — stays out.
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_BLUEDROID_ENABLED=n
CONFIG_BT_CONTROLLER_DISABLED=y
CONFIG_BT_NIMBLE_HOST_TASK_STACK_SIZE=8192
CONFIG_SW_COEXIST_ENABLE=n
CONFIG_FREERTOS_HZ=1000
