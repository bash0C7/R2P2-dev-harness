-    if (vm_list[i]) {
-      mrb_tick(vm_list[i]);
-    }
+  if (board_until_ms >= 0 && (long)(board_ticks + 1) * MRB_TICK_UNIT > board_until_ms) {
+    exit(EXIT_SUCCESS);
   }
+  board_ticks++;
+  mrb_tick(mrb);
 }
