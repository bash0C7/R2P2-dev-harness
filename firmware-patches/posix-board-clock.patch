+/*
+ * Board model clock (R2P2-dev-harness firmware-patches/posix-board-clock.patch,
+ * the same model as the FPGA reference's tools/fpga/v2/board.rb).
+ *
+ * There is no SIGALRM timer. Time is a count of ticks (MRB_TICK_UNIT ms)
+ * and moves one tick at a time only while every task waits
+ * (mrb_hal_task_idle_cpu) or in a blocking sleep (mrb_hal_task_sleep_us);
+ * running code takes no time. FPGA_BOARD_UNTIL_MS=<ms> in the environment
+ * makes the board write its pin changes to stderr (posix-board-gpio.patch)
+ * and exit(0) before a tick past that time.
+ */
+#include <stdio.h>
+#include <stdlib.h>
+
+static uint32_t board_ticks = 0;
+static long board_until_ms = -1;
+
+uint32_t
+fpga_board_ms(void)
+{
+  return board_ticks * MRB_TICK_UNIT;
+}
+
+int
+fpga_board_logging(void)
+{
+  return board_until_ms >= 0;
+}
+
 static void
-sigalrm_handler(int sig)
